[Unit]
Description=Read-only portfolio dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=pf-web
Group=pf-web
WorkingDirectory=/srv/portfolio/current
EnvironmentFile=/etc/portfolio/reader.env
Environment=PF_STATUS_FILE=/var/lib/pf-status/status.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/portfolio/current/.venv/bin/python -m streamlit run streamlit_app.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true --browser.gatherUsageStats=false
ExecStartPost=/usr/local/libexec/pf-ready
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
